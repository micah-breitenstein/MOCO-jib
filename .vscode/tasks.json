{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Arduino CLI: Build Mega master",
			"type": "shell",
			"command": "arduino-cli",
			"args": [
				"compile",
				"--fqbn",
				"arduino:avr:mega",
				"${workspaceFolder}/MEGA__master"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "Arduino CLI: Upload Mega master",
			"type": "shell",
			"command": "arduino-cli",
			"args": [
				"upload",
				"-v",
				"-p",
				"/dev/cu.usbmodem11301",
				"--fqbn",
				"arduino:avr:mega",
				"${workspaceFolder}/MEGA__master"
			],
			"group": "build"
		},
		{
			"label": "Arduino CLI: Build Matrix",
			"type": "shell",
			"command": "arduino-cli",
			"args": [
				"compile",
				"--fqbn",
				"esp32:esp32:esp32s3",
				"${workspaceFolder}/ESP32-S3-Matrix/ESP32_S3_Matrix_Status"
			],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Arduino CLI: Upload Matrix",
			"type": "shell",
			"command": "arduino-cli",
			"args": [
				"upload",
				"-v",
				"-p",
				"/dev/cu.usbmodem11401",
				"--fqbn",
				"esp32:esp32:esp32s3",
				"${workspaceFolder}/ESP32-S3-Matrix/ESP32_S3_Matrix_Status"
			],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "IDF: Flash Display",
			"type": "shell",
			"command": "idf.py",
			"args": [
				"flash",
				"-p",
				"/dev/cu.usbmodem11101"
			],
			"options": {
				"cwd": "${workspaceFolder}/ESP32-S3"
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "IDF: Build Display",
			"type": "shell",
			"command": "idf.py",
			"args": [
				"build"
			],
			"options": {
				"cwd": "${workspaceFolder}/ESP32-S3"
			},
			"group": "build",
			"problemMatcher": []
		}
	]
}