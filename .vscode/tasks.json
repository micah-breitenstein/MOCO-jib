{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Arduino CLI: Build Mega master",
			"type": "shell",
			"command": "arduino-cli",
			"args": [
				"compile",
				"--fqbn",
				"arduino:avr:mega",
				"${workspaceFolder}/MOCO-control/MEGA__master"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "Arduino CLI: Upload Mega master",
			"type": "shell",
			"command": "arduino-cli",
			"args": [
				"upload",
				"-v",
				"-p",
				"/dev/cu.usbmodem11401",
				"--fqbn",
				"arduino:avr:mega",
				"${workspaceFolder}/MOCO-control/MEGA__master"
			],
			"group": "build"
		},
		{
			"label": "Arduino CLI: Build Matrix",
			"type": "shell",
			"command": "arduino-cli",
			"args": [
				"compile",
				"--fqbn",
				"esp32:esp32:esp32s3",
				"${workspaceFolder}/MOCO-matrix/ESP32_S3_Matrix_Status"
			],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Arduino CLI: Upload Matrix",
			"type": "shell",
			"command": "arduino-cli",
			"args": [
				"upload",
				"-v",
				"-p",
				"/dev/cu.usbmodem11301",
				"--fqbn",
				"esp32:esp32:esp32s3",
				"${workspaceFolder}/MOCO-matrix/ESP32_S3_Matrix_Status"
			],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "IDF: Flash Display",
			"type": "shell",
			"command": ". $HOME/.espressif/v5.5.2/esp-idf/export.sh && idf.py flash -p /dev/cu.usbmodem11301",
			"options": {
				"cwd": "${workspaceFolder}/MOCO-display"
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "IDF: Build Display",
			"type": "shell",
			"command": ". $HOME/.espressif/v5.5.2/esp-idf/export.sh && idf.py build",
			"options": {
				"cwd": "${workspaceFolder}/MOCO-display"
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Clean and rebuild MOCO display",
			"type": "shell",
			"command": "cd MOCO-display && rm -rf build && . $HOME/.espressif/v5.5.2/esp-idf/export.sh && idf.py build flash -p /dev/cu.usbmodem1301 monitor",
			"isBackground": false
		},
		{
			"label": "Flash and Monitor MOCO display",
			"type": "shell",
			"command": "cd MOCO-display && . $HOME/.espressif/v5.5.2/esp-idf/export.sh && idf.py flash -p /dev/cu.usbmodem1301 monitor",
			"isBackground": false
		},
		{
			"label": "Flash and Monitor",
			"type": "shell",
			"command": "cd MOCO-display && . $HOME/.espressif/v5.5.2/esp-idf/export.sh && idf.py flash -p /dev/cu.usbmodem1301 monitor",
			"isBackground": true
		},
		{
			"label": "Clean rebuild and flash",
			"type": "shell",
			"command": "cd MOCO-display && rm -rf build sdkconfig && . $HOME/.espressif/v5.5.2/esp-idf/export.sh && idf.py build && idf.py -p /dev/cu.usbmodem1301 flash monitor",
			"isBackground": true
		},
		{
			"label": "Restore and rebuild",
			"type": "shell",
			"command": "cd MOCO-display && git checkout sdkconfig && . $HOME/.espressif/v5.5.2/esp-idf/export.sh && idf.py build flash -p /dev/cu.usbmodem1301 monitor",
			"isBackground": true
		}
	]
}